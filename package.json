{
    "name": "forgedvtt",
    "productName": "ForgeDVTT",
    "version": "1.5.0",
    "description": "ForgeDVTT Virtual Tabletop (VTT) Desktop App & Server",
    "author": "ForgeDVTT Team <lovemurgod92@gmail.com>",
    "main": "electron/main.js",
    "type": "module",
    "scripts": {
        "lint": "eslint server/ vtt/js/ electron/ test/ scripts/",
        "lint:fix": "eslint server/ vtt/js/ electron/ test/ scripts/ --fix",
        "format:check": "prettier --check \"server/**/*.js\" \"vtt/js/**/*.js\" \"electron/**/*.js\" \"test/**/*.mjs\" \"scripts/**/*.mjs\"",
        "format": "prettier --write \"server/**/*.js\" \"vtt/js/**/*.js\" \"electron/**/*.js\" \"test/**/*.mjs\" \"scripts/**/*.mjs\"",
        "typecheck": "tsc -p jsconfig.json",
        "test": "node scripts/run-tests.mjs",
        "test:coverage": "node scripts/run-tests.mjs --coverage",
        "test:e2e": "node test/run_canvas_interactions_e2e.cjs",
        "test:visual": "playwright test -c playwright.config.mjs",
        "test:visual:update": "playwright test -c playwright.config.mjs --update-snapshots",
        "test:visual:report": "playwright show-report",
        "test:sync": "playwright test test/visual/live-sync.spec.mjs -c playwright.config.mjs",
        "test:vision": "playwright test test/visual/fog-vision.spec.mjs -c playwright.config.mjs",
        "test:damage-fx": "playwright test test/visual/damage-animations.spec.mjs -c playwright.config.mjs",
        "test:touch": "playwright test test/visual/mobile-gestures.spec.mjs -c playwright.config.mjs",
        "test:assets": "playwright test test/visual/asset-manager.spec.mjs -c playwright.config.mjs",
        "test:network": "playwright test test/visual/network-recovery.spec.mjs -c playwright.config.mjs",
        "test:portals": "playwright test test/visual/portals-traps.spec.mjs -c playwright.config.mjs",
        "test:drawings": "playwright test test/visual/drawings-shapes-gm-layer.spec.mjs -c playwright.config.mjs",
        "test:dice": "playwright test test/visual/dice-physics-whispers.spec.mjs -c playwright.config.mjs",
        "test:tools": "playwright test test/visual/canvas-tools-pointer-matrix.spec.mjs -c playwright.config.mjs",
        "test:menu": "playwright test test/visual/token-context-sidebar-tabs.spec.mjs -c playwright.config.mjs",
        "test:better20": "playwright test test/visual/better20-character-importer.spec.mjs -c playwright.config.mjs",
        "test:handouts": "playwright test test/visual/handouts-and-adventure-import.spec.mjs -c playwright.config.mjs",
        "test:token-modal": "playwright test test/visual/token-edit-modal.spec.mjs -c playwright.config.mjs",
        "test:bestiary": "playwright test test/visual/bestiary-spawning-rolls.spec.mjs -c playwright.config.mjs",
        "test:menu-bounds": "playwright test test/visual/token-context-menu-bounds.spec.mjs -c playwright.config.mjs",
        "test:builder": "playwright test test/visual/character-builder-wizard.spec.mjs -c playwright.config.mjs",
        "test:builder:lifecycle": "node test/test_character_builder_wizard_lifecycle.mjs",
        "test:custom": "playwright test test/visual/custom-item-spell-wizard.spec.mjs -c playwright.config.mjs",
        "test:custom:lifecycle": "node test/test_custom_item_spell_lifecycle.mjs",
        "test:tables": "playwright test test/visual/roll-tables-and-decks.spec.mjs -c playwright.config.mjs",
        "test:tables:lifecycle": "node test/test_roll_tables_and_decks.mjs",
        "test:audit:mobile": "playwright test test/visual/layout-audit.spec.mjs -c playwright.config.mjs --project=desktop-chrome",
        "start": "node server.js",
        "dev": "nodemon server.js",
        "online": "node launcher.js",
        "build:creatures": "node scripts/build-creature-db.mjs",
        "build:spells": "node scripts/build-spell-db.mjs",
        "build:items": "node scripts/build-item-db.mjs",
        "build:compendium": "node scripts/build-compendium-db.mjs",
        "build:handouts": "node scripts/build-handout-db.mjs",
        "build:dbs": "node scripts/build-spell-db.mjs && node scripts/build-creature-db.mjs && node scripts/build-item-db.mjs && node scripts/build-compendium-db.mjs && node scripts/build-handout-db.mjs",
        "build:srd": "node scripts/build-srd-db.mjs",
        "build:web": "node scripts/build-static-web.mjs",
        "release:stage": "node scripts/prepare-clean-release.mjs",
        "sync:content": "node scripts/sync-partnered-brew.mjs",
        "sync:partnered": "node scripts/sync-partnered-brew.mjs --partnered-only",
        "app": "electron .",
        "push": "electron-builder --dir",
        "dist": "node scripts/prepare-clean-release.mjs && electron-builder --config electron-builder-srd.json",
        "dist:portable": "node scripts/prepare-clean-release.mjs && electron-builder --config electron-builder-srd.json --win portable",
        "dist:full": "electron-builder",
        "dist:full:portable": "electron-builder --win portable"
    },
    "dependencies": {
        "compression": "^1.8.2",
        "cors": "^2.8.5",
        "dompurify": "^3.4.17",
        "express": "^4.19.2",
        "multer": "^1.4.5-lts.1",
        "socket.io": "^4.7.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.65.0",
        "electron": "^30.0.0",
        "electron-builder": "^24.13.3",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "jsdom": "^29.1.1",
        "nodemon": "^3.1.0",
        "prettier": "^3.9.10",
        "typescript": "^7.0.2"
    },
    "build": {
        "appId": "com.forgedvtt.desktop",
        "productName": "ForgeDVTT",
        "executableName": "ForgeDVTT",
        "asar": true,
        "asarUnpack": [
            "package.json",
            "node_modules/**/*",
            "electron/**/*",
            "server/**/*",
            "server.js",
            "launcher.js",
            "utils.js",
            "vtt/**/*"
        ],
        "directories": {
            "output": "dist"
        },
        "files": [
            "server.js",
            "launcher.js",
            "utils.js",
            "matto.json",
            "LEGAL.md",
            "electron/**/*",
            "server/**/*",
            "vtt/**/*",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "resources/bin",
                "to": "bin",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "win": {
            "executableName": "ForgeDVTT",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "dir",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "electron/icon.ico",
            "forceCodeSigning": false,
            "sign": null
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "ForgeDVTT",
            "installerIcon": "electron/icon.ico",
            "uninstallerIcon": "electron/icon.ico",
            "installerHeaderIcon": "electron/icon.ico",
            "artifactName": "ForgeDVTT-Setup-${version}.${ext}"
        }
    }
}
